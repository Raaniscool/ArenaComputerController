+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const Inspection = require('../extension/inspection-schema.js');
+
+const requestId = 'b1aaf39d-6ed0-4cab-9d4f-85ee4dd58106';
+function validSnapshot() {
+  return {
+    requestId,
+    capturedAt: '2026-10-26T12:00:00.000Z',
+    objectCount: 2,
+    truncated: true,
+    objects: [
+      { id: 'o1', parentId: 'workspace', depth: 1, name: 'Platforms', className: 'Folder' },
+      { id: 'o2', parentId: 'o1', depth: 2, name: 'Spawn', className: 'Part', properties: {
+        position: { x: 0, y: 5, z: 0 }, size: { x: 12, y: 1, z: 12 }, color: { x: 80, y: 160, z: 220 },
+        material: 'SmoothPlastic', anchored: true, canCollide: true,
+      } },
+    ],
+  };
+}
+
+test('inspection schema accepts bounded hierarchy and the BasePart property allowlist', () => {
+  assert.equal(Inspection.validateSnapshot(validSnapshot(), requestId), true);
+});
+
+test('inspection schema rejects mismatched IDs, malformed parents/depths, extra fields, and property types', () => {
+  const badSnapshots = [];
+  badSnapshots.push({ ...validSnapshot(), extra: true });
+  badSnapshots.push({ ...validSnapshot(), requestId: 'c1aaf39d-6ed0-4cab-9d4f-85ee4dd58106' });
+  badSnapshots.push({ ...validSnapshot(), objectCount: 1 });
+  badSnapshots.push({ ...validSnapshot(), objects: [{ ...validSnapshot().objects[1], parentId: 'missing' }] });
+  badSnapshots.push({ ...validSnapshot(), objects: [{ ...validSnapshot().objects[0], depth: 3 }] });
+  badSnapshots.push({ ...validSnapshot(), truncated: false });
+  const withPropertiesOnFolder = validSnapshot();
+  withPropertiesOnFolder.objects[0].properties = { ...validSnapshot().objects[1].properties };
+  badSnapshots.push(withPropertiesOnFolder);
+  badSnapshots.push({ ...validSnapshot(), objects: [{ ...validSnapshot().objects[0], properties: {} }, validSnapshot().objects[1]] });
+  badSnapshots.push({ ...validSnapshot(), objects: [validSnapshot().objects[0], { ...validSnapshot().objects[1], properties: { ...validSnapshot().objects[1].properties, source: 'code' } }] });
+  badSnapshots.push({ ...validSnapshot(), objects: [validSnapshot().objects[0], { ...validSnapshot().objects[1], properties: { ...validSnapshot().objects[1].properties, anchored: 1 } }] });
+  for (const value of badSnapshots) assert.equal(Inspection.validateSnapshot(value, requestId), false);
+});
+
+test('inspection schema enforces object and serialized-byte caps', () => {
+  const tooMany = validSnapshot();
+  tooMany.objects = Array.from({ length: Inspection.MAX_OBJECTS + 1 }, (_, i) => ({
+    id: `o${i + 1}`, parentId: 'workspace', depth: 1, name: `Object${i + 1}`, className: 'Folder',
+  }));
+  tooMany.objectCount = tooMany.objects.length;
+  assert.equal(Inspection.validateSnapshot(tooMany, requestId), false);
+
+  const tooLarge = validSnapshot();
+  tooLarge.objects = Array.from({ length: Inspection.MAX_OBJECTS }, (_, i) => ({
+    id: `o${i + 1}`, parentId: 'workspace', depth: 1, name: 'x'.repeat(1024), className: 'Folder',
+  }));
+  tooLarge.objectCount = tooLarge.objects.length;
+  tooLarge.truncated = true;
+  assert.equal(Inspection.validateSnapshot(tooLarge, requestId), false);
+});
+
+test('inspection handoff builds a bounded, explicit unsent draft and preserves existing composer text', () => {
+  const snapshot = validSnapshot();
+  const draft = Inspection.appendSnapshotToDraft('Please inspect this project.  ', snapshot);
+  assert.ok(draft.startsWith('Please inspect this project.\n\n'));
+  assert.ok(draft.includes('Snapshot-local IDs'));
+  assert.ok(draft.includes(JSON.stringify(snapshot)));
+  assert.ok(new TextEncoder().encode(Inspection.formatSnapshot(snapshot)).byteLength <= Inspection.MAX_DRAFT_BYTES);
+  assert.equal(Inspection.appendSnapshotToDraft('', { ...snapshot, extra: true }), null);
+});
+
+test('Arena content script wires inspection to visible preview and an unsent draft, not an automatic send', () => {
+  const fs = require('node:fs');
+  const source = fs.readFileSync(require.resolve('../extension/content.js'), 'utf8');
+  assert.match(source, /inspectButton\.addEventListener\('click', requestInspection\)/);
+  assert.match(source, /type: 'request_inspection'/);
+  assert.match(source, /inspectionPreview\.textContent = formatted/);
+  assert.match(source, /INSPECTION\.appendSnapshotToDraft\(editor\.value, latestInspection\)/);
+  const draftHandler = source.slice(source.indexOf("draftInspectionButton.addEventListener('click'"), source.indexOf("draftButton.addEventListener('click'"));
+  assert.match(draftHandler, /setTextareaValue\(editor, draft\)/);
+  assert.doesNotMatch(draftHandler, /requestSubmit|\.submit\(/);
+});
+
+
+test('Studio collector source shows bounded BFS and excludes character-like Workspace models without Players service access', () => {
+  const fs = require('node:fs');
+  const source = fs.readFileSync(require.resolve('../studio-plugin/ArenaRobloxConnector.plugin.lua'), 'utf8');
+  const collector = source.slice(source.indexOf('local function collectWorkspaceSnapshot'), source.indexOf('local function submitInspectionResult'));
+  assert.match(collector, /GetChildren\(\)/);
+  assert.match(source, /INSPECTION_MAX_DEPTH = 2/);
+  assert.match(source, /INSPECTION_MAX_OBJECTS = 32/);
+  assert.match(collector, /INSPECTION_MAX_DEPTH/);
+  assert.match(collector, /INSPECTION_MAX_OBJECTS/);
+  assert.match(collector, /FindFirstChildOfClass\("Humanoid"\)/);
+  assert.doesNotMatch(collector, /GetDescendants|GetService\("Players"\)|\.Source|GetAttributes/);
+});
