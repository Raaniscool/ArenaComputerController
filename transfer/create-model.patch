+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const source = fs.readFileSync(path.join(__dirname, '../studio-plugin/ArenaRobloxConnector.plugin.lua'), 'utf8');
+
+test('Studio source constructs a Model with ordinary anchored Parts before parenting and verifies read-back', () => {
+  const buildAt = source.indexOf('local model = Instance.new("Model")');
+  const partAt = source.indexOf('local part = Instance.new("Part")', buildAt);
+  const precheckAt = source.indexOf('modelMatches(model, operation)', partAt);
+  const parentAt = source.indexOf('model.Parent = parent', precheckAt);
+  const postcheckAt = source.indexOf('model.Parent ~= parent or not modelMatches(model, operation)', parentAt);
+  assert.ok(buildAt >= 0 && partAt > buildAt && precheckAt > partAt && parentAt > precheckAt && postcheckAt > parentAt);
+  assert.match(source, /part\.Anchored = true/);
+  assert.match(source, /part\.ClassName ~= "Part"/);
+  assert.match(source, /ArenaConnectorRequestId/);
+  assert.match(source, /MODEL_STAGING_NAME = "ArenaConnectorStaging"/);
+});
+
+test('Studio preview includes the fixed target and all requested Part properties; session label guard is retained', () => {
+  assert.match(source, /Workspace\/ArenaConnectorStaging/);
+  for (const field of ['position', 'size', 'color', 'material', 'canCollide']) assert.match(source, new RegExp('part\\.' + field));
+  assert.match(source, /string\.sub\(currentSession, 1, 8\)/);
+});
